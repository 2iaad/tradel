generator client {
  provider = "prisma-client"
  output   = "packages/database/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model refresh_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_refresh_tokens_user_id")
}

model email_verification_tokens {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String      @unique @db.Uuid
  token_hash      String      @unique @db.VarChar(64)
  expires_at      DateTime    @db.Timestamptz(6)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  users           users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_email_verification_tokens_expires_at")
}

model users {
  id                         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                   String?          @unique @db.VarChar(15)
  email                      String           @unique @db.VarChar(254)
  password_hash              String?
  google_sub                 String?          @unique @db.VarChar(255)
  created_at                 DateTime         @default(now()) @db.Timestamptz(6)
  email_verified_at          DateTime?        @db.Timestamptz(6)
  accounts                   accounts[]
  refresh_tokens             refresh_tokens[]
  email_verification_tokens  email_verification_tokens[]
}

model accounts {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  name             String   @db.VarChar(50)
  broker           String?  @db.VarChar(60)
  currency         String   @default("USD") @db.VarChar(3)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  starting_balance Decimal  @default(0) @db.Decimal(14, 2)
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  trades           trades[]

  @@unique([user_id, name], map: "idx_accounts_user_id_name")
}

model trades {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id  String   @db.Uuid
  symbol      String   @db.VarChar(20)
  side        String   @db.VarChar(5)
  entry       Decimal  @db.Decimal
  exit        Decimal? @db.Decimal
  lots        Decimal  @db.Decimal
  risk_reward Decimal? @db.Decimal
  pnl         Decimal? @db.Decimal
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  notes       notes[]
  accounts    accounts @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id, account_id])
  @@index([account_id], map: "idx_trades_account_id")
}

model notes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id String   @db.Uuid
  trade_id   String   @db.Uuid
  title      String   @db.VarChar(50)
  body       String
  tags       String[] @default([])
  created_at DateTime @default(now()) @db.Timestamptz(6)
  trades     trades   @relation(fields: [trade_id, account_id], references: [id, account_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id], map: "idx_notes_account_id")
  @@index([trade_id], map: "idx_notes_trade_id")
}
