{
    "name": "tradel",
    "private": true,
    "workspaces": [
        "packages/shared",
        "apps/api",
        "apps/web"
    ],
    "scripts": {
        "predev": "npm run build:shared",
        "dev": "concurrently -k -n shared,api,web -c yellow,blue,cyan \"npm run dev --workspace=@tradel/shared\" \"npm run start:dev --workspace=@tradel/api\" \"npm run dev --workspace=@tradel/web\"",
        "predev:api": "npm run build:shared",
        "dev:api": "concurrently -k -n shared,api -c yellow,blue \"npm run dev --workspace=@tradel/shared\" \"npm run start:dev --workspace=@tradel/api\"",
        "predev:web": "npm run build:shared",
        "dev:web": "concurrently -k -n shared,web -c yellow,cyan \"npm run dev --workspace=@tradel/shared\" \"npm run dev --workspace=@tradel/web\"",
        "build:shared": "npm run build --workspace=@tradel/shared",
        "build": "npm run build --workspace=@tradel/api --workspace=@tradel/web",
        "lint": "npm run lint --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "format": "npm run format --workspaces --if-present",
        "prisma:generate": "npm run prisma:generate --workspace=@tradel/api",
        "prisma:pull": "npm run prisma:pull --workspace=@tradel/api",
        "prisma:studio": "npm run prisma:studio --workspace=@tradel/api",
        "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace=@tradel/api",
        "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=@tradel/api",
        "diagram:generate": "npm run diagram:generate --workspace=@tradel/api",
        "logs:heroku": "heroku logs --tail"
    },
    "engines": {
        "node": "22.x"
    },
    "devDependencies": {
        "concurrently": "^10.0.5",
        "prettier": "^3.4.2"
    }
}
