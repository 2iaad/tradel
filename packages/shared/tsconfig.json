{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["ES2017"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "strict": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "types": []
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist", "node_modules"]
}
