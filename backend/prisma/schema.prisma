generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  name             String   @db.VarChar(50)
  broker           String?  @db.VarChar(60)
  currency         String   @default("USD") @db.VarChar(3)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  starting_balance Decimal  @default(0) @db.Decimal(14, 2)
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  trades           trades[]

  @@unique([user_id, name], map: "idx_accounts_user_id_name")
}

model notes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id String   @db.Uuid
  trade_id   String   @db.Uuid
  title      String   @db.VarChar(50)
  body       String
  tags       String[] @default([])
  created_at DateTime @default(now()) @db.Timestamptz(6)
  trades     trades   @relation(fields: [trade_id, account_id], references: [id, account_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id], map: "idx_notes_account_id")
  @@index([trade_id], map: "idx_notes_trade_id")
}

